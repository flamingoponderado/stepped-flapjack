import SteppedFlapjack.PanToCrepSteps.TailEntrySteps
import Flapjack.Pancake.PanGlobals.CompileTopExact
import Flapjack.Pancake.Proofs.PanGlobals.CompileDecsStructural
import Flapjack.Pancake.Proofs.PanGlobals.DeclListLemmas
import SteppedFlapjack.LoopLiveSteps.FrontendMember
import Flapjack.Pancake.PanToCrep.CompileExact
import Flapjack.Pancake.PanToWord

/-! Identify the tail-call wrapper generated by the actual globals pass. -/
namespace SteppedFlapjack.PanToCrepSteps
open Flapjack Flapjack.Pancake.PanLang Flapjack.Basis.Pure.MlString

/-- Whenever the source start function is present, the global-lowering output
contains the generated wrapper with the actual initializer and renamed callee. -/
theorem compileTop_entry_wrapper {width : Nat} [NeZero width]
    (declarations : List (DeclHOL width)) (start : MlString)
    (args : List (MlString × ShapeHOL)) (body : ProgHOL width) (shape : ShapeHOL)
    (found : (functionsHOL declarations).lookup start = some (args,body,shape)) :
    ∃ initializers funs exns context,
      let renamed := fpermDecsHOL start (newMainNameHOL declarations) (resortDeclsHOL declarations)
      let initial : PanGlobalsContextExact width :=
        { globals := HolFiniteMapExact.empty, globalsSize := 0,
          maxGlobalsSize := cakeBytesInWord width * BitVec.ofNat width ((decShapesHOL renamed).map sizeOfShapeHOL).sum }
      compileDecsExactHOL initial renamed = (initializers,funs,exns,context) ∧
      compileTopExactHOL declarations start = exns ++ (.function
        { name := start, inline := false, exported := false, params := args,
          body := .seq (nestedSeqHOL initializers)
            (.call none (newMainNameHOL declarations) (args.map (fun parameter => .var .local parameter.1))),
          returnShape := shape } :: funs) := by
  let renamed := fpermDecsHOL start (newMainNameHOL declarations) (resortDeclsHOL declarations)
  let initial : PanGlobalsContextExact width :=
    { globals := HolFiniteMapExact.empty, globalsSize := 0,
      maxGlobalsSize := cakeBytesInWord width * BitVec.ofNat width ((decShapesHOL renamed).map sizeOfShapeHOL).sum }
  rcases hcompile : compileDecsExactHOL initial renamed with ⟨initializers,funs,exns,context⟩
  refine ⟨initializers,funs,exns,context,hcompile,?_⟩
  simp only [compileTopExactHOL,compileTopFunctionLookup_eq_lookup,found]
  rw [show compileDecsExactHOL initial renamed = (initializers,funs,exns,context) from hcompile]

/-- The generated global-entry wrapper is the first function in the lowered
program, even when exception declarations precede it. -/
theorem compileTop_first_function {width : Nat} [NeZero width]
    (declarations : List (DeclHOL width)) (start : MlString)
    (args : List (MlString × ShapeHOL)) (body : ProgHOL width) (shape : ShapeHOL)
    (found : (functionsHOL declarations).lookup start = some (args,body,shape)) :
    ∃ initializers rest,
      functionsHOL (compileTopExactHOL declarations start) =
        (start,args,.seq (nestedSeqHOL initializers)
          (.call none (newMainNameHOL declarations) (args.map (fun parameter => .var .local parameter.1))),shape) :: rest := by
  obtain ⟨initializers,funs,exns,context,compiled,top⟩ :=
    compileTop_entry_wrapper declarations start args body shape found
  have noFunctions : functionsHOL exns = [] := by
    rw [PanGlobalsCompileDecsStructural.compile_decs_exns_are_exnsHOL _ _ _ _ _ _ compiled]
    exact PanGlobalsDeclListExact.functions_FILTER_exn_declHOL _
  refine ⟨initializers,functionsHOL funs,?_⟩
  rw [top,functionsHOL_append,noFunctions]
  rfl

/-- The actual Pancake-to-Crep compiler retains the generated zero-argument
entry as its first function, including after Crep inlining. -/
theorem compileProgDecls_first_entry {width : Nat} [NeZero width]
    (declarations : List (DeclHOL width)) (start : MlString)
    (body : ProgHOL width) (shape : ShapeHOL)
    (found : (functionsHOL declarations).lookup start = some ([],body,shape)) :
    ∃ compiled rest, compileProgDeclsHOLW (compileTopExactHOL declarations start) = (start,[],compiled) :: rest := by
  obtain ⟨initializers,rest,hfunctions⟩ := compileTop_first_function declarations start [] body shape found
  unfold compileProgDeclsHOLW CrepInlineCanonical.compileInlTopHOLExact
    CrepInlineCanonical.compileInlProgHOLExactWithSupport compileToCrepExactHOLW
  simp only [hfunctions,List.map_cons,crepVarsHOL,List.map_nil,sizeOfShapeHOL,sizeOfShapesHOL,List.range_zero]
  exact ⟨_,_,rfl⟩

/-- The actual compiled Word list contains the generated global-entry function
at the compiler's first Loop name, with its exact compiler-generated context. -/
theorem compileTop_first_word_entry {width : Nat} [NeZero width]
    (arch : Compiler.Encoders.Asm.AsmArchitecture)
    (declarations : List (DeclHOL width)) (start : MlString)
    (body : ProgHOL width) (shape : ShapeHOL)
    (found : (functionsHOL declarations).lookup start = some ([],body,shape)) :
    ∃ loop,
      let ctxt := makeCtxtHOL 2 (LoopToWord.fromNumSetHOL (sptDifference (accVarsHOL loop .ln) (LoopToWord.toNumSetHOL []))) .ln
      (firstLoopName,1,(LoopToWord.compHOL ctxt loop (firstLoopName,2)).1) ∈
        loopToWordCompileHOL (compileProgHOLExact arch (compileProgDeclsHOLW (compileTopExactHOL declarations start))) := by
  obtain ⟨compiled,rest,hentry⟩ := compileProgDecls_first_entry declarations start body shape found
  let code := compileProgDeclsHOLW (compileTopExactHOL declarations start)
  let loop := optimiseHOL (compFuncHOLExact arch (crepToLoopMakeFuncsExactExecutable code) [] (crepSimpProgHOL compiled))
  have member : (firstLoopName,[],loop) ∈ compileProgHOLExact arch code := by
    apply List.mem_iff_getElem.mpr
    refine ⟨0,?_,?_⟩
    · simp [compileProgHOLExact,code,hentry]
    · simp [compileProgHOLExact,loop,code,hentry]
  exact ⟨loop,LoopLiveSteps.loopToWord_zeroArg_member _ _ _ member⟩

/-- The complete Pancake-to-Word output contains the real global-entry wrapper
at the standard first function location. -/
theorem panToWord_first_entry {width : Nat} [NeZero width]
    (arch : Compiler.Encoders.Asm.AsmArchitecture) (source : List (DeclHOL width))
    (body : ProgHOL width) (shape : ShapeHOL)
    (found : (functionsHOL (Pancake.PanStructs.CompileShapeExact.compileTopExact (panSimpDeclsHOL source))).lookup
      (ofString "main") = some ([],body,shape)) :
    ∃ loop,
      let ctxt := makeCtxtHOL 2 (LoopToWord.fromNumSetHOL (sptDifference (accVarsHOL loop .ln) (LoopToWord.toNumSetHOL []))) .ln
      (firstLoopName,1,(LoopToWord.compHOL ctxt loop (firstLoopName,2)).1) ∈ panToWordCompileProgHOL arch source := by
  simpa only [panToWordCompileProgHOL] using
    compileTop_first_word_entry arch (Pancake.PanStructs.CompileShapeExact.compileTopExact (panSimpDeclsHOL source))
      (ofString "main") body shape found

end SteppedFlapjack.PanToCrepSteps
