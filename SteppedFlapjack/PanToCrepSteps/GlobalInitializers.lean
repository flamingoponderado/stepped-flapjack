import SteppedFlapjack.PanToCrepSteps.GlobalShapes
import Flapjack.Pancake.PanGlobals.CompileTopExact

/-! Supported scalar global declarations yield supported generated stores. -/
namespace SteppedFlapjack.PanToCrepSteps
open Flapjack Flapjack.Pancake.PanLang Flapjack.Basis.Pure.MlString

/-- If every global initializer is scalar, all stores generated by global
lowering lie in the supported branch fragment, for any starting context. -/
theorem globalCompile_scalar_initializers {width : Nat} [NeZero width]
    (ctxt : PanToCrepContextExact width) (declarations : List (DeclHOL width))
    (scalar : ∀ shape name value, DeclHOL.decl shape name value ∈ declarations → ScalarExpression ctxt value)
    (globals : PanGlobalsContextExact width) :
    ∀ initializer ∈ (compileDecsExactHOL globals declarations).1, BranchProgram ctxt initializer := by
  induction declarations generalizing globals with
  | nil => simp [compileDecsExactHOL]
  | cons d ds ih =>
    have tailScalar : ∀ shape name value, DeclHOL.decl shape name value ∈ ds → ScalarExpression ctxt value := by
      intro shape name value h
      exact scalar shape name value (by simp [h])
    cases d with
    | function fn =>
      simpa only [compileDecsExactHOL] using ih tailScalar globals
    | exnDecl name shape =>
      simpa only [compileDecsExactHOL] using ih tailScalar globals
    | name name fields =>
      simpa only [compileDecsExactHOL] using ih tailScalar globals
    | decl shape name value =>
      have hv := scalar shape name value (by simp)
      simp only [compileDecsExactHOL]
      intro initializer member
      simp only [List.mem_cons] at member
      rcases member with rfl | member
      · exact BranchProgram.store (.op .sub .topAddr (.const _)) (globalCompile_scalar_shape globals hv)
      · exact ih tailScalar _ initializer member

/-- Sequences of the generated scalar stores are supported by the machine
frontend, including the empty initializer sequence. -/
theorem globalCompile_scalar_initializer_sequence {width : Nat} [NeZero width]
    (ctxt : PanToCrepContextExact width) (declarations : List (DeclHOL width))
    (scalar : ∀ shape name value, DeclHOL.decl shape name value ∈ declarations → ScalarExpression ctxt value)
    (globals : PanGlobalsContextExact width) :
    BranchProgram ctxt (nestedSeqHOL (compileDecsExactHOL globals declarations).1) := by
  have hs := globalCompile_scalar_initializers ctxt declarations scalar globals
  generalize (compileDecsExactHOL globals declarations).1 = inits at hs ⊢
  induction inits with
  | nil => simpa [nestedSeqHOL] using (BranchProgram.skip (context := ctxt))
  | cons p ps ih =>
    simp only [nestedSeqHOL]
    exact .seq (hs p (by simp)) (ih (by intro q h; exact hs q (by simp [h])))


/-- A real scalar global declaration generates a supported nonempty store
sequence and its actual Pancake-to-Crep output has a supported branch shape. -/
theorem globalCompile_constant_initializer_example {width : Nat} [NeZero width]
    (ctxt : PanToCrepContextExact width) (globals : PanGlobalsContextExact width)
    (name : MlString) (value : BitVec width) :
    let declarations : List (DeclHOL width) := [.decl .one name (.const value)]
    let initializers := (compileDecsExactHOL globals declarations).1
    initializers ≠ [] ∧ BranchProgram ctxt (nestedSeqHOL initializers) ∧
      CrepToLoopSteps.BranchProgram (compileProgExactHOLW ctxt (nestedSeqHOL initializers)) := by
  have scalar : ∀ shape n e, DeclHOL.decl shape n e ∈
      ([.decl .one name (.const value)] : List (DeclHOL width)) → ScalarExpression ctxt e := by
    intro shape n e h
    simp only [List.mem_singleton,DeclHOL.decl.injEq] at h
    rcases h with ⟨rfl,rfl,rfl⟩
    exact .const _
  have h := globalCompile_scalar_initializer_sequence ctxt [.decl .one name (.const value)] scalar globals
  refine ⟨?_,h,branch_compile h⟩
  simp [compileDecsExactHOL]

end SteppedFlapjack.PanToCrepSteps
